# 统一换行符，避免跨机器提交时整文件“全变了”
* text=auto

# Gradle Wrapper 的 shell 脚本必须保持 LF，否则 Linux/macOS 下报 bad interpreter
gradlew text eol=lf
*.sh    text eol=lf

# Windows 批处理保持 CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不要做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
*.jar   binary
*.apk   binary
*.aab   binary
*.keystore binary
*.jks   binary
*.zip   binary
