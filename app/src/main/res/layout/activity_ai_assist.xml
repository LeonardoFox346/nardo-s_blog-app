<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 辅助编程（MD3，二级页，由「关于本应用」页的入口卡进入）

  结构：品牌头图 → DeepSeek 段 → 渐变过渡线 → Kimi 段
  · 第一段讲当前负责本工程的 AI 助手（运行于 DeepSeek Harness）
  · 第二段是 Kimi Code 当年的自我介绍，自原「关于 KIMI Code」页原样保留，作为历史记录
  ⛔ 站长 2026-10-01 口径：两段放在同一页，但仍要让人一眼看出「谁是谁」。
  ★ 2026-10-01 第二轮：站长要求删掉原引言卡、页面风格由我重设计 —— 改为
    「渐变品牌头图（鲸鱼水印 + 玻璃圆底 logo + 胶囊 byline）＋ 渐变编号徽章能力卡」。
-->
<!--
  ★ tools:ignore="HardcodedText" 只压这一条：本页能力卡左侧的 1~5 是**序号装饰**，
    不是可翻译的文案（换成 @string 反而让「1」进本地化清单）。其余文案一律已外置。
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/aiAssistRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    tools:ignore="HardcodedText">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationContentDescription="@string/action_back"
            app:navigationIcon="@drawable/ic_nav_back"
            app:title="@string/ai_assist_title"
            app:titleTextAppearance="@style/TextAppearance.LabNardo.TitleMedium" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp">

            <!-- ================= 品牌头图（DeepSeek 段） ================= -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_ai_hero"
                android:clipToOutline="true"
                android:elevation="3dp">

                <!-- 右侧鲸鱼水印（纯装饰，不参与无障碍）★ 必须染白，否则蓝底蓝图看不见 -->
                <ImageView
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="4dp"
                    android:alpha="0.16"
                    android:importantForAccessibility="no"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_deepseek"
                    app:tint="#FFFFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="64dp"
                            android:layout_height="64dp">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_logo_tile" />

                            <ImageView
                                android:layout_width="46dp"
                                android:layout_height="46dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/about_ai_name"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_deepseek" />

                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/about_ai_name"
                                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                                android:textColor="#FFFFFFFF" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/about_ai_tagline"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="#D9FFFFFF" />

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="18dp"
                        android:layout_marginBottom="14dp"
                        android:background="#33FFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:background="@drawable/bg_chip_glass"
                        android:paddingStart="14dp"
                        android:paddingTop="7dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="7dp"
                        android:text="@string/about_ai_byline"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="#FFFFFFFF" />

                </LinearLayout>

            </FrameLayout>

            <!-- ================= 能力小节 ================= -->

