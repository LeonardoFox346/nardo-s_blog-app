<?xml version="1.0" encoding="utf-8"?>
<!--
  Lab.Nardo 设置页（MD3）
  · 顶部 MaterialToolbar（返回箭头 + 标题）
  · 品牌信息卡：MaterialCardView（MD3 tonal 表面色）
  · 操作项：统一使用 Widget.LabNardo.SettingsAction（MD3 TonalButton 派生）
  · 文案全部外置到 strings.xml，图标用 app:icon 而非 drawableStart（MD3 按钮规范）
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorSurface"
            app:navigationContentDescription="@string/action_back"
            app:navigationIcon="@drawable/ic_nav_back"
            app:title="@string/settings_title"
            app:titleTextAppearance="@style/TextAppearance.LabNardo.TitleMedium" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="112dp"
                        android:layout_height="112dp"
                        android:contentDescription="@string/app_name"
                        android:scaleType="centerCrop"
                        android:src="@drawable/header_image"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.LabNardo.Circle" />

                    <TextView
                        android:id="@+id/tvBrandInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.3"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearCache"
                    style="@style/Widget.LabNardo.SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/clear_cache"
                    app:icon="@drawable/ic_clear_cache" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnActiveTabs"
                    style="@style/Widget.LabNardo.SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/active_tabs_count"
                    app:icon="@drawable/ic_tabs" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPermissions"
                    style="@style/Widget.LabNardo.SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/permissions"
                    app:icon="@drawable/ic_security" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrivacy"
                    style="@style/Widget.LabNardo.SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/privacy"
                    app:icon="@drawable/ic_privacy" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutSite"
                    style="@style/Widget.LabNardo.SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/about_site"
                    app:icon="@drawable/ic_link" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutApp"
                    style="@style/Widget.LabNardo.SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/about_app_author"
                    app:icon="@drawable/ic_person" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAboutAi"
                    style="@style/Widget.LabNardo.SettingsAction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_app"
                    app:icon="@drawable/ic_info" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
