<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:background="@android:color/white">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/header_image"
            android:scaleType="centerCrop"
            android:background="@drawable/ic_launcher"
            android:clipToOutline="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Powered By LeonardoFox\nVersion 2.5.7_final\nDesign By KimiAI"
            android:textSize="12sp"
            android:textColor="#757575"
            android:gravity="center"
            android:paddingTop="12dp"
            android:lineSpacingMultiplier="1.3" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnClearCache"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="遇到错误？试试清除缓存"
            android:textColor="@android:color/white"
            android:backgroundTint="#F44336"
            android:drawableStart="@drawable/ic_clear_cache"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnActiveTabs"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="更改活跃标签页数量"
            android:textColor="@android:color/white"
            android:backgroundTint="#9C27B0"
            android:drawableStart="@drawable/ic_tabs"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="应用权限声明"
            android:textColor="@android:color/white"
            android:backgroundTint="#2196F3"
            android:drawableStart="@drawable/ic_security"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnPrivacy"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="应用隐私协议"
            android:textColor="@android:color/white"
            android:backgroundTint="#3F51B5"
            android:drawableStart="@drawable/ic_privacy"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnAboutSite"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="关于纳多狐狐实验室网站"
            android:textColor="@android:color/white"
            android:backgroundTint="#4CAF50"
            android:drawableStart="@drawable/ic_link"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnAboutApp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="关于APP作者"
            android:textColor="@android:color/white"
            android:backgroundTint="#FF9800"
            android:drawableStart="@drawable/ic_person"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="start|center_vertical" />

        <Button
            android:id="@+id/btnAboutKimi"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="关于 KIMI CODE"
            android:textColor="@android:color/white"
            android:backgroundTint="#00BCD4"
            android:drawableStart="@drawable/ic_kimi"
            android:drawableTint="@android:color/white"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="start|center_vertical" />

    </LinearLayout>

</LinearLayout>
