<?xml version="1.0" encoding="utf-8"?>
<!--
  Lab.Nardo MD3 色彩 — 夜间（深色）
  与 res/values/colors_md3.xml 同名覆盖，保证深色模式下对比度符合 MD3 规范。
-->
<resources>

    <!-- Primary（主色） -->
    <color name="md_primary">#FFD0BCFF</color>
    <color name="md_on_primary">#FF381E72</color>
    <color name="md_primary_container">#FF4F378B</color>
    <color name="md_on_primary_container">#FFEADDFF</color>

    <!-- Secondary（次色） -->
    <color name="md_secondary">#FFCCC2DC</color>
    <color name="md_on_secondary">#FF332D41</color>
    <color name="md_secondary_container">#FF4A4458</color>
    <color name="md_on_secondary_container">#FFE8DEF8</color>

    <!-- Tertiary（强调色） -->
    <color name="md_tertiary">#FFEFB8C8</color>
    <color name="md_on_tertiary">#FF492532</color>
    <color name="md_tertiary_container">#FF633B48</color>
    <color name="md_on_tertiary_container">#FFFFD8E4</color>

    <!-- Error（错误） -->
    <color name="md_error">#FFF2B8B5</color>
    <color name="md_on_error">#FF601410</color>
    <color name="md_error_container">#FF8C1D18</color>
    <color name="md_on_error_container">#FFF9DEDC</color>

    <!-- Surface（表面）与背景 -->
    <color name="md_background">#FF1C1B1F</color>
    <color name="md_on_background">#FFE6E1E5</color>
    <color name="md_surface">#FF1C1B1F</color>
    <color name="md_on_surface">#FFE6E1E5</color>
    <color name="md_surface_variant">#FF49454F</color>
    <color name="md_on_surface_variant">#FFCAC4D0</color>
    <color name="md_inverse_surface">#FFE6E1E5</color>
    <color name="md_inverse_on_surface">#FF313033</color>

    <!-- Outline（描边） -->
    <color name="md_outline">#FF938F99</color>
    <color name="md_outline_variant">#FF49454F</color>

    <!-- 其它 -->
    <color name="md_scrim">#FF000000</color>
    <color name="md_shadow">#FF000000</color>

    <!-- 语义辅助色（深色下提亮以保证 4.5:1 对比度） -->
    <color name="status_active">#FF81C995</color>
    <color name="status_hibernated">#FF9AA0A6</color>

</resources>
